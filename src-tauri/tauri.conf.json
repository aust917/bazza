{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bazza",
  "version": "0.4.0",
  "identifier": "app.bazza.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bazza",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": true
      },
      {
        "label": "popup",
        "title": "Bazza",
        "url": "index.html?window=popup",
        "width": 400,
        "height": 236,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true
      },
      {
        "label": "recordbar",
        "title": "Bazza recording",
        "url": "index.html?window=recordbar",
        "width": 560,
        "height": 72,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CONFIG/Bazza/**",
          "$APPDATA/**"
        ]
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/bazza-diarize"
    ],
    "category": "Productivity",
    "shortDescription": "Local-only meeting recorder with private AI",
    "longDescription": "Bazza records your meetings locally, transcribes them with speaker labels and lets you chat with a private, on-device AI about them. Nothing leaves your computer.",
    "resources": {
      "resources/*": "./",
      "resources/nemo-speech/": "nemo-speech/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    },
    "publisher": "Bazza contributors",
    "copyright": "MIT License",
    "createUpdaterArtifacts": false
  },
  "plugins": {}
}
